# Copy to a root-owned file outside Git, replace every REPLACE_* value, and
# pass it to costmarshal_production_deploy.py with --env-file. This file
# contains paths and immutable identities only; never place secret contents
# here.

COSTMARSHAL_GATEWAY_IMAGE=ghcr.io/REPLACE_OWNER/costmarshal/gateway@sha256:REPLACE_64_HEX_DIGEST

# The bundled Compose topology is single-host. Both published ports stay on
# loopback; managed Workers use the internal labelled Docker network.
COSTMARSHAL_BROKER_BIND_IP=127.0.0.1
COSTMARSHAL_PROXY_BIND_IP=127.0.0.1
COSTMARSHAL_BROKER_ENDPOINT=https://127.0.0.1:8443/v1/leases
COSTMARSHAL_PROVIDER_PROXY_ENDPOINT=https://127.0.0.1:9443/v1

COSTMARSHAL_GATEWAY_STATE_DIR=/var/lib/costmarshal
COSTMARSHAL_GATEWAY_AUDIT_DIR=/var/log/costmarshal
COSTMARSHAL_PROVIDER_CREDENTIALS_DIR=/etc/costmarshal/provider-credentials

COSTMARSHAL_LEASE_SIGNING_KEY_FILE=/etc/costmarshal/secrets/lease-signing-key
COSTMARSHAL_BROKER_TLS_CERT_FILE=/etc/costmarshal/tls/broker.crt
COSTMARSHAL_BROKER_TLS_KEY_FILE=/etc/costmarshal/tls/broker.key
COSTMARSHAL_WORKLOAD_CLIENT_CA_FILE=/etc/costmarshal/tls/workload-ca.crt
COSTMARSHAL_PROXY_TLS_CERT_FILE=/etc/costmarshal/tls/proxy.crt
COSTMARSHAL_PROXY_TLS_KEY_FILE=/etc/costmarshal/tls/proxy.key

# Used by the scheduler, deployment live-health verification, and evidence
# collectors. The CA bundle must validate both Broker and Proxy server certs.
COSTMARSHAL_BROKER_CLIENT_CERT_FILE=/etc/costmarshal/tls/worker.crt
COSTMARSHAL_BROKER_CLIENT_KEY_FILE=/etc/costmarshal/tls/worker.key
COSTMARSHAL_BROKER_CA_FILE=/etc/costmarshal/tls/server-ca.crt
